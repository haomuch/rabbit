# HTML 页面：始终重新验证，支持条件请求（304 Not Modified）
/index.html
  Cache-Control: no-cache, must-revalidate

/game.html
  Cache-Control: no-cache, must-revalidate

# 样式表：长期缓存（如需更新，请更改文件名或添加版本参数）
/assets/css/*
  Cache-Control: public, max-age=31536000

# 脚本：长期缓存
/assets/js/*
  Cache-Control: public, max-age=31536000

# 图片：长期缓存
/assets/images/*
  Cache-Control: public, max-age=2592000

# 图标：长期缓存
/assets/icons/*
  Cache-Control: public, max-age=2592000
